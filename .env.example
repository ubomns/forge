# ─── Forge environment variables (placeholders only — never commit real secrets) ───

# OpenAI (required — /api/generate returns 500 if unset)
OPENAI_API_KEY=sk-your-key-here

# FastAPI URL for the Next.js dev proxy (defaults to http://localhost:8000)
FASTAPI_URL=http://localhost:8000

# Runtime environment: development | test | production
ENVIRONMENT=development

# Database (ADR-002). Dev default is SQLite; prod uses Postgres.
DATABASE_URL=sqlite:///./forge.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/forge?sslmode=require

# Auth (ADR-001). REQUIRED — generate a strong random secret, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-generate-a-32-byte-hex-secret

# Watermark referral URL base (ADR-011). Must resolve live before exports ship.
PUBLIC_BASE_URL=https://forgeplan.com

# ─── Billing (later sprints — stubs today) ───
# Stripe (Sprint 3)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Paystack (Sprint 4/5)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
